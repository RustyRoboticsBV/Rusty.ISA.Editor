                        <field_definition id="b_field" parameter="b"/>
                    </form_definition>
                </choice_definition>
            </tuple_definition>
        </list_definition>
        <form_definition id="jump_form" instruction="jump">
            <port_definition id="target_port" parameter="target"/>
        </form_definition>
    </node_definition>
    
    <start_point id="start"/>

